DATABASE_URL=sqlite:///./returnwise.db
CORS_ORIGINS=http://localhost:3000
API_KEY=
RISK_THRESHOLDS=0.3,0.6,0.8
RETURN_WINDOW_DAYS=30
# Optional OpenAI-compatible LLM. Core functionality requires no key.
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=

# Local demo: demo@returnwise.ai / ReturnWise@123
# Production must configure the email and password hash below.
APP_ENV=development
LOGIN_EMAIL=demo@returnwise.ai
LOGIN_PASSWORD_HASH=
SESSION_COOKIE_SECURE=false
